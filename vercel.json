{
  "crons": [
    {
      "path": "/api/send-relances",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/agent-leads",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/agent-pub",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/scan-sites-batiment",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/generer-maquette",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/extraire-contacts-sites",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/mobile",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/catalogues/resine-gomme.pdf",
      "destination": "https://wklddwumirkdjkbxvzyj.supabase.co/storage/v1/object/public/media/catalogue-ecosky-web.pdf",
      "permanent": false
    },
    {
      "source": "/catalogues/portails.pdf",
      "destination": "https://wklddwumirkdjkbxvzyj.supabase.co/storage/v1/object/public/puv%20skyeco/catalogue-portails.pdf",
      "permanent": false
    }
  ]
}